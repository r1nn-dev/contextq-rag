{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextQ SSE events",
  "description": "SSE event contract (docs/specs/api-spec.md > 부록 B). Root validates the client leg (backend -> browser). Use $defs/upstreamEvent for the internal leg (ai-server -> backend). Stream order rules (INV-06) are checked by the contract tests, not by this schema.",
  "$ref": "#/$defs/clientEvent",
  "$defs": {
    "clientEvent": {
      "description": "Event sent by backend to the browser (POST /api/v1/chat/stream).",
      "oneOf": [
        { "$ref": "#/$defs/clientMeta" },
        { "$ref": "#/$defs/token" },
        { "$ref": "#/$defs/done" },
        { "$ref": "#/$defs/error" }
      ]
    },
    "upstreamEvent": {
      "description": "Event sent by ai-server to backend (POST /internal/v1/chat/stream).",
      "oneOf": [
        { "$ref": "#/$defs/upstreamMeta" },
        { "$ref": "#/$defs/token" },
        { "$ref": "#/$defs/done" },
        { "$ref": "#/$defs/error" }
      ]
    },

    "clientMeta": {
      "description": "meta on the client leg. backend adds conversationId and messageId; both are null for guests (no DB record).",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/metaRules" }],
      "required": ["event", "requestId", "conversationId", "messageId"],
      "properties": {
        "event": { "const": "meta" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "conversationId": { "$ref": "#/$defs/nullableId" },
        "messageId": { "$ref": "#/$defs/nullableId" },
        "sourceKey": { "$ref": "#/$defs/sourceKey" },
        "ingestRunId": { "$ref": "#/$defs/id" },
        "commitSha": { "$ref": "#/$defs/commitSha" },
        "ingestedAt": { "$ref": "#/$defs/date" },
        "sourceKeyA": { "$ref": "#/$defs/sourceKey" },
        "sourceKeyB": { "$ref": "#/$defs/sourceKey" },
        "ingestRunIdA": { "$ref": "#/$defs/id" },
        "ingestRunIdB": { "$ref": "#/$defs/id" },
        "commitShaA": { "$ref": "#/$defs/commitSha" },
        "commitShaB": { "$ref": "#/$defs/commitSha" },
        "ingestedAtA": { "$ref": "#/$defs/date" },
        "ingestedAtB": { "$ref": "#/$defs/date" },
        "rewrittenQuery": { "type": ["string", "null"] },
        "noContext": { "type": "boolean" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      },
      "additionalProperties": false
    },
    "upstreamMeta": {
      "description": "meta on the internal leg. ai-server does not know conversationId or messageId.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/metaRules" }],
      "required": ["event", "requestId"],
      "properties": {
        "event": { "const": "meta" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "sourceKey": { "$ref": "#/$defs/sourceKey" },
        "ingestRunId": { "$ref": "#/$defs/id" },
        "commitSha": { "$ref": "#/$defs/commitSha" },
        "ingestedAt": { "$ref": "#/$defs/date" },
        "sourceKeyA": { "$ref": "#/$defs/sourceKey" },
        "sourceKeyB": { "$ref": "#/$defs/sourceKey" },
        "ingestRunIdA": { "$ref": "#/$defs/id" },
        "ingestRunIdB": { "$ref": "#/$defs/id" },
        "commitShaA": { "$ref": "#/$defs/commitSha" },
        "commitShaB": { "$ref": "#/$defs/commitSha" },
        "ingestedAtA": { "$ref": "#/$defs/date" },
        "ingestedAtB": { "$ref": "#/$defs/date" },
        "rewrittenQuery": { "type": ["string", "null"] },
        "noContext": { "type": "boolean" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      },
      "additionalProperties": false
    },
    "metaRules": {
      "description": "Shared meta rules: compare fields come in A/B pairs (부록 B.4); noContext=true carries no sources (부록 B.1).",
      "dependentRequired": {
        "sourceKeyA": ["sourceKeyB"],
        "sourceKeyB": ["sourceKeyA"],
        "ingestRunIdA": ["ingestRunIdB"],
        "ingestRunIdB": ["ingestRunIdA"],
        "commitShaA": ["commitShaB"],
        "commitShaB": ["commitShaA"],
        "ingestedAtA": ["ingestedAtB"],
        "ingestedAtB": ["ingestedAtA"]
      },
      "if": {
        "required": ["noContext"],
        "properties": { "noContext": { "const": true } }
      },
      "then": {
        "properties": { "sources": { "maxItems": 0 } }
      }
    },

    "token": {
      "type": "object",
      "required": ["event", "t"],
      "properties": {
        "event": { "const": "token" },
        "t": { "type": "string" }
      },
      "additionalProperties": false
    },

    "done": {
      "type": "object",
      "required": ["event", "status"],
      "properties": {
        "event": { "const": "done" },
        "status": { "enum": ["COMPLETED", "PARTIAL", "NO_CONTEXT", "FAILED"] },
        "statusReason": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z_]*$" },
        "finishReason": { "type": ["string", "null"] },
        "usage": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["prompt", "completion"],
              "properties": {
                "prompt": { "type": "integer", "minimum": 0 },
                "completion": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "latency": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "rewriteMs": { "$ref": "#/$defs/nullableMs" },
                "embedMs": { "$ref": "#/$defs/nullableMs" },
                "retrieveMs": { "$ref": "#/$defs/nullableMs" },
                "ttftMs": { "$ref": "#/$defs/nullableMs" },
                "totalMs": { "$ref": "#/$defs/nullableMs" }
              },
              "additionalProperties": false
            }
          ]
        },
        "invalidCitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        },
        "compareResult": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/compareResult" }]
        },
        "model": {
          "description": "Actual model name returned by the LLM API (INV-13 snapshot). null when the LLM was not called.",
          "type": ["string", "null"]
        },
        "promptVersion": {
          "description": "Prompt file name used for generation, e.g. single_v1 (INV-13 snapshot).",
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },

    "error": {
      "type": "object",
      "required": ["event", "code", "message", "requestId", "partial"],
      "properties": {
        "event": { "const": "error" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "partial": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "required": ["rank", "headingPath", "permalink", "siteUrl", "similarity"],
      "properties": {
        "rank": { "$ref": "#/$defs/citation" },
        "headingPath": { "type": "string" },
        "permalink": { "type": "string", "pattern": "^https://" },
        "siteUrl": { "type": "string", "pattern": "^https://" },
        "similarity": { "type": "number", "minimum": -1, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "compareResult": {
      "description": "Post-validated compare output (docs/planning/policy.md > §5.6). Inner keys stay snake_case.",
      "type": "object",
      "required": ["version_a", "version_b", "changes"],
      "properties": {
        "version_a": { "$ref": "#/$defs/compareSide" },
        "version_b": { "$ref": "#/$defs/compareSide" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["aspect", "a", "b", "citations_a", "citations_b"],
            "properties": {
              "aspect": { "type": "string" },
              "a": { "type": "string" },
              "b": { "type": "string" },
              "citations_a": { "type": "array", "items": { "$ref": "#/$defs/compareCitationA" } },
              "citations_b": { "type": "array", "items": { "$ref": "#/$defs/compareCitationB" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compareSide": {
      "type": "object",
      "required": ["summary", "citations", "no_evidence"],
      "properties": {
        "summary": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "no_evidence": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "requestId": { "type": "string", "minLength": 1 },
    "id": { "type": "integer", "minimum": 1 },
    "nullableId": { "type": ["integer", "null"], "minimum": 1 },
    "nullableMs": { "type": ["integer", "null"], "minimum": 0 },
    "sourceKey": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "citation": {
      "description": "Single mode ranks are integers (1..K); compare mode ranks are A1..Ak / B1..Bk (policy §5.6).",
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[AB][1-9][0-9]*$" }
      ]
    },
    "compareCitationA": { "type": "string", "pattern": "^A[1-9][0-9]*$" },
    "compareCitationB": { "type": "string", "pattern": "^B[1-9][0-9]*$" }
  }
}
