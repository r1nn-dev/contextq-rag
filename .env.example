# =============================================================
# ContextQ-RAG — .env.example
# cp .env.example .env  →  fill in values in .env
# Never commit .env. Secrets are managed via GitHub Secrets.
# =============================================================


# Docker Compose
COMPOSE_PROJECT_NAME=contextq

# OpenAI — LLM + embeddings
OPENAI_API_KEY=

# Answer generation model override (optional). Unset = ai-server/configs/models.yaml llm.model.
# The embedding model is fixed in ai-server/configs/models.yaml (no env var; INV-03).
# Generation parameters (temperature 0, max_tokens, first-token timeout) live in configs/models.yaml.
# LLM_MODEL=gpt-4o-mini


# PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_USER=contextq
POSTGRES_PASSWORD=
POSTGRES_DB=contextq_db

# Spring Boot DataSource
DATABASE_URL=jdbc:postgresql://postgres:5432/contextq_db
DATABASE_USERNAME=contextq
DATABASE_PASSWORD=


# JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7


# Admin seed (optional) — created once at startup, skipped when the account exists.
# ADMIN_PASSWORD_BCRYPT must be a BCrypt hash ($2a$10$...), never the plain password.
ADMIN_EMAIL=
ADMIN_PASSWORD_BCRYPT=


# Internal auth token — Spring Boot → FastAPI (X-Internal-Token header)
INTERNAL_TOKEN=


# Chroma (vector DB)
CHROMA_DATA_DIR=./data/chroma

# Index snapshot storage for infra/scripts/index-snapshot-s3.sh (operator scripts only).
# AWS credentials come from the aws CLI default chain (instance role / profile), not from this file.
# SNAPSHOT_S3_URI=s3://<bucket>/index-snapshots


# AI server (FastAPI)
AI_SERVER_PORT=8000

# AI server profile: local | staging | loadtest | prod
# prod fails to start if INGEST_ENABLED or LLM_MOCK is true (policy INV-17)
APP_PROFILE=local
INGEST_ENABLED=false
# Root for collected sources (raw/) and run reports (reports/); relative to ai-server
INGEST_DATA_DIR=./data
# GitHub token for permalink validation in the index gate (optional)
GITHUB_TOKEN=
LLM_MOCK=false

# Internal URL used by Spring Boot to reach the AI server (within Docker Compose network)
AI_SERVER_INTERNAL_URL=http://ai-server:8000

# NO_CONTEXT threshold override per source_key (optional, ADR-008)
# Unset = ai-server/configs/rag.yaml retrieval.thresholds (dev 0.30, finalized by E1).
# Top-K and the context budget live in ai-server/configs/rag.yaml (no env var).
# TAU_LANGCHAIN_V03=
# TAU_LANGCHAIN_V1X=


# Backend (Spring Boot)
BACKEND_PORT=8080

# New guest sessions per IP per hour (policy §8.1; 60 on the exhibition day)
GUEST_SESSIONS_PER_IP_PER_HOUR=30

# Daily questions per logged-in user (KST day, compare mode counts 2; policy §8.1).
# The guest limit (5 per session) is fixed by a DB constraint and has no variable.
DAILY_QUOTA=100

# Compose / nginx (infra/docker-compose.yml)
# Image name = ${IMAGE_REGISTRY}/<service>:${IMAGE_TAG}. Deployments use the git SHA as the tag, never latest.
# IMAGE_REGISTRY=contextq
# IMAGE_TAG=local
NGINX_HTTP_PORT=80
# Chat rate limit per IP (policy 8.1; exhibition day 60r/m burst 20)
# NGINX_RATE_CHAT=30r/m
# NGINX_BURST_CHAT=10

# Frontend (Vite / React)

# API base URL prefix used by the browser. Keep empty: the app calls same-origin /api/...
# (Vite dev proxy forwards /api to the backend; nginx does the same in production; no CORS)
VITE_API_BASE_URL=
