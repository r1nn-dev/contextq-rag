# =============================================================
# ContextQ-RAG — .env.example
# cp .env.example .env  →  fill in values in .env
# Never commit .env. Secrets are managed via GitHub Secrets.
# =============================================================


# Docker Compose
COMPOSE_PROJECT_NAME=contextq

# OpenAI — LLM + embeddings
OPENAI_API_KEY=

# Answer generation model (temperature=0, seed=42 — fixed for reproducibility)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_TIMEOUT_SECONDS=30

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small


# PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_USER=contextq
POSTGRES_PASSWORD=
POSTGRES_DB=contextq_db

# Spring Boot DataSource
DATABASE_URL=jdbc:postgresql://postgres:5432/contextq_db
DATABASE_USERNAME=contextq
DATABASE_PASSWORD=


# JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7


# Chroma (vector DB)
CHROMA_PORT=8001
CHROMA_DATA_PATH=/app/chroma_db

# Active index run_id — updated via make activate-index
ACTIVE_RUN_ID=


# AI server (FastAPI)
AI_SERVER_PORT=8000

# Internal URL used by Spring Boot to reach the AI server (within Docker Compose network)
AI_SERVER_INTERNAL_URL=http://ai-server:8000

# NO_CONTEXT threshold — finalized per source_key after E1 experiment
TAU_LANGCHAIN_V03=0.5
TAU_LANGCHAIN_V1X=0.5

# Retrieval top-k
RETRIEVAL_TOP_K=3


# Backend (Spring Boot)
BACKEND_PORT=8080

# Max questions per anonymous session
GUEST_QUOTA=5

# Daily quota for authenticated users
DAILY_QUOTA=100

# Frontend (Vite / React)
FRONTEND_PORT=5173

# API base URL called directly from the browser
VITE_API_BASE_URL=http://localhost:8080
