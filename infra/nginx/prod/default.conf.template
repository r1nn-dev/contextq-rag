# 배포 server (HTTPS) — docker-compose.prod.yml이 /etc/nginx/templates/default.conf.template 자리에 연결한다.
# 정책서 §11: HTTPS 전용, HTTP → HTTPS 301, HSTS 1년(security-headers.conf).
# 인증서는 호스트 /etc/letsencrypt(Let's Encrypt, infra/scripts/tls-init.sh)를 읽기 전용으로 받는다.

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # 컨테이너 헬스체크는 HTTP로 한다 (리다이렉트하지 않음)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${NGINX_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_SERVER_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:1m;
    ssl_session_timeout 1d;

    include /etc/nginx/conf.d/app.locations;
}
