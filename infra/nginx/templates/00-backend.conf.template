# http 수준 공용 설정 — 기동 시 envsubst로 /etc/nginx/conf.d/00-backend.conf가 된다(server 파일보다 먼저 읽힘).
# ${NGINX_*}만 치환되고 nginx 변수($...)는 그대로다.

# 레이트 리밋 3구간 — IP 단위 (정책서 §8.1). 초과는 429
limit_req_zone $binary_remote_addr zone=auth:1m rate=${NGINX_RATE_AUTH};
limit_req_zone $binary_remote_addr zone=chat:1m rate=${NGINX_RATE_CHAT};
limit_req_zone $binary_remote_addr zone=api:2m rate=${NGINX_RATE_API};
limit_req_status 429;

# backend 컨테이너가 재시작해 IP가 바뀌어도 따라가도록 Docker 내장 DNS로 다시 조회한다(nginx 1.27.3+ `resolve`)
resolver 127.0.0.11 valid=10s ipv6=off;

upstream backend {
    zone backend 64k;
    server backend:8080 resolve;
    keepalive 16;
}
